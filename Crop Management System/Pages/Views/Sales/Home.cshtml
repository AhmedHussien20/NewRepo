        //const scripts = contentWithoutScripts.getElementsByTagName('script');

        // Open a document in the print window and write content to it
        console.log(element);
        var content = `<html><head><title>${fileName}</title></head>`;
        var body = `${element}</html>`;
        console.log(content);
        content += body;
        //for (let i = scripts.length - 1; i >= 0; i--) {
        //    scripts[i].parentNode.removeChild(scripts[i]);
        //}
        console.log(content);

        // Open a new window for printing
