@page
@model Crop_Management_System.Pages.Views.Transportation.IdtModel
@{
}

<div>
    <h4 class="mt-4">IDT</h4>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active"><a href="@Url.Page("/Index")" class="ml-1 mr-1">Dashboard</a> / IDT</li>
    </ol>

    <div class="mb-4">
        <div class="row">
            <div class="col-md-6">
                <a onclick="getProvinceData()" class="btn btn-outline-primary w-100" data-toggle="collapse" href="#locationFilter" role="button" aria-expanded="false"
                   aria-controls="locationFilter">
                    <h5>
                        Location Filter
                        <i class="icofont-dotted-down"></i>
                    </h5>
                </a>
            </div>
            <div class="col-md-6">
                <a class="btn btn-outline-primary w-100" data-toggle="collapse" href="#dateFilter" role="button" aria-expanded="false"
                   aria-controls="dateFilter">
                    <h5>
                        Date Filter
                        <i class="icofont-dotted-down"></i>
                    </h5>
                </a>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <div id="locationFilter" class="collapse border border-info rounded p-3">
            <div class="row">
                <div class="col-md-4">
                    <label class="font-weight-bold">Province <i class="icofont-dotted-down"></i></label>
                    <select class="form-control " name="provinceId" id="provinceId" onchange="provinceChangeListener()" required>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="font-weight-bold">
                        <span id="districtSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                        District
                        <i class="icofont-dotted-down"></i>
                    </label>
                    <select class="form-control" name="districtId" id="districtId" onchange="districtChangeListener()" required>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="font-weight-bold">
                        <span id="sateliteSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                        Satellite
                        <i class="icofont-dotted-down"></i>
                    </label>
                    <select class="form-control" name="SateliteId" id="sateliteId" onchange="sateliteChangeListener()" required>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <div id="dateFilter" class="collapse border border-info rounded p-3">
            <div class="row  ">
                <div class="col-md-6">
                    <label class="font-weight-bold">Start Date <i class="icofont-dotted-down"></i></label>
                    <input id="startDate" type="date" class="form-control" value="" />
                </div>
                <div class="col-md-6">
                    <label class="font-weight-bold">
                        <span class="d-none spinner-border"></span>
                        End Date
                        <i class="icofont-dotted-down"></i>
                    </label>
                    <input id="endDate" type="date" class="form-control" value="" />
                </div>
                <div class="col-md-12 mt-4">
                    <button onclick="dateFilter()" class="btn btn-outline-primary w-100">Filter</button>
                </div>
            </div>
        </div>
    </div>

    <!-- database table -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table mr-1"></i>
            Current IDT
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>IDT-Date</th>
                            <th>IDT-Details</th>
                            <th>Location Details</th>
                            <th>Crop Description</th>
                            <th>Order Details</th>
                            <th>Vendor Details</th>
                            <th>Driver Details</th>
                            <th>LO-Details</th>
                            <th>Status</th>
                            <!--<th>Actions</th>-->
                        </tr>
                    </thead>
                    <tbody id="tableData" class=""></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="modal" class="modal fade ModelDialog" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <iframe name="dFrame" id="dummyframe" style="display: none;"></iframe>
            <form id="formData" target="dFrame" onsubmit="editForm()" enctype="multipart/form-data">
                <input type="hidden" name="idtNo" />
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Transaction Modal</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Transaction IDTStatus<i class="icofont-dotted-down"></i></label>
                        <select class="form-control" name="IDTStatus" id="status">
                            <option value="Approved">Approved</option>
                            <option value="Retract">Retract</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button id="btnEdit" type="submit" class="btn btn-primary">
                        <span id="btnSpinner" class="d-none spinner-border  spinner-grow-sm" role="status" aria-hidden="true"></span>
                        Save changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var today = new Date();
    var responseList = [];
    var startIndex = 0;
    var batchSize = 100;
    var dataTable;
    var responseList = [];
    var filterDate = true;
    var filterLocation = true;

    $(document).ready(async function () {
        $('#startDate').val(getDateValue(today));
        $('#endDate').val(getDateValue(today));
        initializeDatatable();
        //await getProvinceData();
        displayMainBody();
    });

    async function getData(shouldFilter, dateFilter, locationFilter, startDate, endDate, location) {
        $("#tableSpinner").removeClass('d-none');
        var formData = {
            "startDate": startDate,
            "endDate": endDate,
            "shouldFilter": shouldFilter,
            "dateFilter": dateFilter,
            "locationFilter": locationFilter,
            "location": location,
            "startIndex": startIndex,
            "batchSize": batchSize
        };

        //await makeGetRequest(baseUrl + `IDTGetByLocation?location=${sateliteValue}`).then(response => {
            /*if (response != null) {
                // Loop through the response results and push data into responseList
                for (let i in response.results) {
                    var dataList = response.results[i];
                    responseList.push(dataList);
                }
            } */


            // Add rows to the DataTable after initialization
        await makePostRequest(formData, baseUrl + "getAllIDT").then(response => {
            for (let i in response.results) {
                var dataList = response.results[i];
                responseList.push(dataList);
                dataTable.row.add([
                    dataList.idtDate,
                    `<label class="small">IDT-No:<br /> <b>${dataList.idtNo}</b></label> <br />
                         <label class="small">LO-NO:<br /> <b>${dataList.loNumber}</b></label> <br />`,
                    `<label class="small">From:<br /> <b>${dataList.fromLocName}</b></label> <br />
                         <label class="small">TO:<br /> <b>${dataList.toLocName}</b></label> <br />
                         <label class="small">GITLOC: <b>${dataList.gitloc}</b></label> <br />`,
                    `<label class="small">Item-No:<br /> <b>${dataList.sItemNo}</b></label> <br />
                         <label class="small">Description:<br /> <b>${dataList.sDesc}</b></label> <br />`,
                    `<label class="small">Unit: <b>${dataList.sUnit}</b></label> <br />
                         <label class="small">QtyTransBG: <b>${checkIfValid(dataList.sQtyTransBG, dataList.retractedTransBG, dataList.idtStatus)}</b></label> <br />
                         <label class="small">Avg-Weig: <b>${dataList.sAvgWeig}</b></label> <br />
                         <label class="small">Qty-Avail: <b>${dataList.sQtyAvail}</b></label> <br />
                         <label class="small">Bag-Weiged: <b>${dataList.sBagWeiged}</b></label> <br />`,
                    `<label class="small">Vendor:<br /> <b>${dataList.sVendor}</b></label> <br />
                         <label class="small">Name:<br /> <b>${dataList.sVendorName}</b></label> <br />`,
                    `<label class="small">ID:<br /> <b>${dataList.id}</b></label> <br />
                         <label class="small">Driver:<br /> <b>${dataList.driver}</b></label> <br />
                         <label class="small">Vechile:<br /> <b>${dataList.vehicle}</b></label> <br />`,
                    `<label class="small">Prepared-By:<br /> <b>${dataList.idtPreparedBy}</b></label> <br />
                         <label class="small">Complete-Status:<br /> <b>${highlightStatus(dataList.idComplete)}</b></label> <br />`,
                    highlightIDTStatus(dataList.idtStatus, i),
                ]).draw();
            }

           
        });
        $("#tableSpinner").addClass('d-none');
    }

    function initializeDatatable() {
        dataTable = $('#dataTable').DataTable({
            dom: 'Bfrti',
            buttons: [
                'copy', {
                    text: 'CSV', action: function (e, dt, node, config) {
                        // Define headers for the Excel file
                        const headers = [
                            'driver',                // Key person involved in the transaction
                            'vehicle',               // Vehicle information
                            'loNumber',              // Transaction or order number
                            'idtNo',                 // Identifier for the transaction
                            'idtDate',               // Date of transaction
                            'idtPreparedBy',         // Person who prepared the transaction
                            'idtStatus',             // Status of the transaction
                            'idtPrinted',            // Whether the transaction is printed
                            'idtRef',                // Reference for the transaction
                            'idtRefDate',            // Date of reference
                            'sDesc',                 // Description of the product (White Maize)
                            'sItemNo',               // Item number for the product
                            'sVendor',               // Vendor ID
                            'sVendorName',           // Vendor Name (SIMORIET GENERAL DEALERS)
                            'sUnit',                 // Unit type (50KGBAG)
                            'sAvgWeig',              // Average weight
                            'sBagWeiged',            // Bag weight
                            'sContrLoc',             // Contract location (CE)
                            'sQtyAvail',             // Quantity available (0)
                            'sQtyTransBG',           // Quantity transferred in background (11)
                            'fromLoc',               // From location code
                            'fromLocName',           // From location name (Chisamba Batumbu - Chibombo - Central)
                            'gitloc',                // Git location code (CE01GT)
                            'toLoc',                 // To location code
                            'toLocName',             // To location name (Chibombo-Mwachisompola)
                            'serialNumber',          // Serial number (null, no value)
                            'retractedTransBG',      // Retracted transaction background flag (0)
                            'idComplete',            // Completion status (N)
                            'idtIntegrate',          // Integration status (N)
                            'idtModifyBy',           // Modifier of the transaction (null)
                            'idtModifyDate',         // Date of modification (null)
                            'sQtyOrdered',           // Quantity ordered (assumed from context, but not present in data)
                            'nComplete',             // Completion indicator (assumed, not present)
                            'nOnHold',               // Hold status (assumed, not present)
                            'nPosted',               // Posting status (assumed, not present)
                            'notes'                  // Additional notes (assumed, not present)
                        ];
                        const csvData = [
                            headers,
                            ...responseList.map(row =>
                                headers.map(header => row[header] !== undefined ? row[header] : '')  // Ensure the order of data matches headers
                            )
                        ];
                        const csvContent = csvData.map(row => row.join(',')).join('\n');
                        console.log(responseList);
                        const csvBlob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                        const csvURL = URL.createObjectURL(csvBlob);
                        const link = document.createElement('a');
                        link.setAttribute('href', csvURL);
                        link.setAttribute('download', 'CropManagementSystem_GIN.csv');
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    }
                }, {
                    text: 'EXCEL', action: function (e, dt, node, config) {
                        // Define headers for the Excel file
                        const headers = [
                            'driver',                // Key person involved in the transaction
                            'vehicle',               // Vehicle information
                            'loNumber',              // Transaction or order number
                            'idtNo',                 // Identifier for the transaction
                            'idtDate',               // Date of transaction
                            'idtPreparedBy',         // Person who prepared the transaction
                            'idtStatus',             // Status of the transaction
                            'idtPrinted',            // Whether the transaction is printed
                            'idtRef',                // Reference for the transaction
                            'idtRefDate',            // Date of reference
                            'sDesc',                 // Description of the product (White Maize)
                            'sItemNo',               // Item number for the product
                            'sVendor',               // Vendor ID
                            'sVendorName',           // Vendor Name (SIMORIET GENERAL DEALERS)
                            'sUnit',                 // Unit type (50KGBAG)
                            'sAvgWeig',              // Average weight
                            'sBagWeiged',            // Bag weight
                            'sContrLoc',             // Contract location (CE)
                            'sQtyAvail',             // Quantity available (0)
                            'sQtyTransBG',           // Quantity transferred in background (11)
                            'fromLoc',               // From location code
                            'fromLocName',           // From location name (Chisamba Batumbu - Chibombo - Central)
                            'gitloc',                // Git location code (CE01GT)
                            'toLoc',                 // To location code
                            'toLocName',             // To location name (Chibombo-Mwachisompola)
                            'serialNumber',          // Serial number (null, no value)
                            'retractedTransBG',      // Retracted transaction background flag (0)
                            'idComplete',            // Completion status (N)
                            'idtIntegrate',          // Integration status (N)
                            'idtModifyBy',           // Modifier of the transaction (null)
                            'idtModifyDate',         // Date of modification (null)
                            'sQtyOrdered',           // Quantity ordered (assumed from context, but not present in data)
                            'nComplete',             // Completion indicator (assumed, not present)
                            'nOnHold',               // Hold status (assumed, not present)
                            'nPosted',               // Posting status (assumed, not present)
                            'notes'                  // Additional notes (assumed, not present)
                        ];
                        const csvData = [
                            headers,
                            ...responseList.map(row =>
                                headers.map(header => row[header] !== undefined ? row[header] : '')  // Ensure the order of data matches headers
                            )
                        ];
                        const csvContent = csvData.map(row => row.join(',')).join('\n');
                        const csvBlob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                        const csvURL = URL.createObjectURL(csvBlob);
                        const link = document.createElement('a');
                        link.setAttribute('href', csvURL);
                        link.setAttribute('download', 'CropManagementSystem_GIN.csv');
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    }
                }, 'pdf', 'print'
            ],
            "pageLength": 20000,
            "columnDefs": [{ "width": "15%", "targets": 5 }],
            "order": [[7, "desc"]],
            "bDestroy": true,
        });
    }

    //date Filter
    async function dateFilter() {
        var startDate = $('#startDate').val();
        var endDate = $('#endDate').val();
        var sateliteValue = document.getElementById("sateliteId").value;
        var filterLocation = true;
        if (sateliteValue == null || sateliteValue == '') {
            filterLocation = false;
        }
        //$('#dataTable').DataTable({ "bDestroy": true }).clear();
        startIndex = 0;
        responseList = [];
        dataTable.clear().draw();
        filterDate = true;
        await getData(true, filterDate, filterLocation, startDate, endDate, sateliteValue);
    }

    async function getProvinceData() {
        await makeGetRequest(baseUrl + "getProvinces").then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#provinceId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await provinceChangeListener();
            }
        });
    }

    async function provinceChangeListener() {
        $('#districtId').empty();
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $("#districtSpinner").removeClass('d-none');
        dataTable.clear().draw();
        responseList = [];

        var provinceValue = document.getElementById("provinceId").value;
        await makeGetRequest(baseUrl + `getDistricts?provinceCode=${provinceValue}`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#districtId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await districtChangeListener();
            }
        });
        $("#districtSpinner").addClass('d-none');
    }

    async function districtChangeListener() {
        $('#sateliteId').empty();
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $("#sateliteSpinner").removeClass('d-none');
        dataTable.clear().draw();
        responseList = [];

        var districtValue = document.getElementById("districtId").value;
        await makeGetRequest(baseUrl + `getSatelites?disctrictCode=${districtValue}`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#sateliteId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await sateliteChangeListener();
            }
        });
        $("#sateliteSpinner").addClass('d-none');
    }

    async function sateliteChangeListener() {
        $("#deviceSpinner").removeClass('d-none');
        //$('#dataTable').DataTable({ "bDestroy": true }).clear();
        responseList = [];

        var sateliteValue = document.getElementById("sateliteId").value;
        var startDate = $('#startDate').val();
        var endDate = $('#endDate').val();
        startIndex = 0;
        dataTable.clear().draw();
        initializeDatatable();

        // Clear previous DataTable and reset responseList
        //$('#dataTable').DataTable({ "bDestroy": true }).clear();
        await getData(true, filterDate, true, startDate, endDate, sateliteValue);
        $("#deviceSpinner").addClass('d-none');
        
    }

    function editModel(idtNo, status) {
        var table = $('#dataTable').DataTable();
        var Id = idtNo;
        var Status = status;
        console.log(Status);
        $('input[name=idtNo]').val(Id);
        console.log(Id);
        getSelectValue("idtStatus", Status);
        $('#modal').modal('show');
    }

    async function editForm() {
        $("#btnSpinner").removeClass('d-none');
        var formData = $('#formData').serializeArray().reduce(function (obj, item) {
            obj[item.name] = item.value;
            return obj;
        }, {});
        console.log(formData);

        await makePostRequest(formData, baseUrl + "updateIDTStatus").then(async response => {
            console.log(response);
            if (response.error) {
                alertify.error('Unsuccessful - ' + response.errorMessage);
                console.log(response.errorMessage);
            } else {
                //$('#dataTable').DataTable({ "bDestroy": true }).clear();
                //await getData();
                //await getStats();
                alertify.success("Record Updated");
            }
        });

        $("#btnSpinner").addClass('d-none');
        $('#modal').modal('hide');

    }

    function highlightStatus(val) {
        if (val == 'Y') {
            return '<i class="text-success">Y</i>'
        } else {
            return '<i class="text-danger">N</i>'
        }
    }

    function checkIfValid(val, retractedAmount, status) {
        status = status.toLowerCase();
        if (status == "retract") {
            return `<p class="text-danger"><del>${retractedAmount}</del></p>
                    <p class="text-danger">${0}</p>`;
        } else {
            return ` <p class="text-success">${val}</p>`;
        }
    }

    function highlightIDTStatus(val, index) {
        if (val == 'Pending') {
            return `<i class="text-warning" id='status_${index}'>${val}</i>`
        } else if (val == 'Approved') {
            return `<i class="text-success" id='status_${index}'>${val}</i>`
        } else if (val == 'Retract') {
            return `<i class="text-danger" id='status_${index}'>${val}</i>`
        } else {
            return `<i class="text-danger" id='status_${index}'>${val}</i>`
        }
    }
</script>