@page
@model Crop_Management_System.Pages.Views.Admins.AdminsCreationModel
@{ }

<div>
    <div>
        @if (@Model.updateData)
        {
<h4 class="mt-4">Admin Update</h4> }
            else
            {
<h4 class="mt-4">Admin Creation</h4>}
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item active"><a href="@Url.Page("/Views/Admins/Index")" class="ml-1 mr-1">Admin</a> / Staff Creation</li>
        </ol>
    </div>

    <div class="mt-4">
        <div>
            <iframe name="dFrame" id="dummyframe" style="display: none;"></iframe>
            <form id="formData" target="dFrame" onsubmit="submitForm()" enctype="multipart/form-data">
                <div>
                    <h5>Location Information</h5>
                    <div class="border border-info rounded p-3">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="font-weight-bold">Province <i class="icofont-dotted-down"></i></label>
                                <select class="form-control " name="provinceId" id="provinceId" onchange="provinceChangeListener()" required>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold">
                                    <span id="districtSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                                    District
                                    <i class="icofont-dotted-down"></i>
                                </label>
                                <select class="form-control" name="districtId" id="districtId" onchange="districtChangeListener()" required>
                                </select>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <h5>Personal Information</h5>
                    <div class="border border-info rounded p-3">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="font-weight-bold">First Name</label>
                                <input type="text" class="form-control" name="firstName" required autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold">Last Name</label>
                                <input type="text" class="form-control" name="lastName" required autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold mt-3">Email</label>
                                <input type="email" class="form-control" name="email" required autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold mt-3">Phone Number</label>
                                <input type="tel" class="form-control" name="phoneNumber" required autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold mt-3">Gender</label>
                                <select class="form-control" name="gender" id="gender">
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold mt-3">Date Of Birth</label>
                                <input type="date" class="form-control" name="dob" required>
                            </div>
                            @if (!@Model.updateData)
                            {
                <div class="col-md-6">
                    <label class="font-weight-bold mt-3">Temporary Password</label>
                    <input type="password" class="form-control" name="password" required autocomplete="off">
                </div>}
                            <div class="col-md-6">
                                <label class="font-weight-bold mt-3">NRC Number</label>
                                <input type="text" class="form-control" name="nrcNumber" required autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold mt-3">Account Status <i class="icofont-dotted-down"></i></label>
                                <select class="form-control" name="accountStatusId" id="accountStatusId">
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold mt-3">Role<i class="icofont-dotted-down"></i></label>
                                <select class="form-control" name="roleId" id="roleId">
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold mt-3">Province</label>
                                <input disabled type="text" class="form-control province" name="province" id="Province" required autocomplete="off">
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold mt-3">District</label>
                                <input disabled type="text" class="form-control district" name="district" id="District" required autocomplete="off">
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-4 mb-4">
                        <span id="btnSpinner" class="d-none spinner-border  spinner-grow-sm" role="status" aria-hidden="true"></span>
                        SUBMIT
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var accountId;

    $(document).ready(async function () {
        var userRole = getCookie("userRole");

        if (userRole != "Admin") {
            window.location.href = "/Unauthorized";
        }
        await getData();
        displayMainBody();
    });

    async function getData() {
        await makeGetRequest(baseUrl + `getAllAccountStatus`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#accountStatusId').append($('<option>', {
                        value: dataList.id,
                        text: dataList.title,
                    }));
                }
            }
        });
        await makeGetRequest(baseUrl + `getAllRoles`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#roleId').append($('<option>', {
                        value: dataList.id,
                        text: dataList.title,
                    }));
                }
            }
        });
        @if (@Model.updateData)
        {
            @Html.Raw("await getProvinceData();");
            @Html.Raw("await getUserDataForUpdate();");
        }
        else {
        @Html.Raw("await getProvinceData();");
        }
    }

    async function getUserDataForUpdate() {
        var userID = "@Model.userId";
        await makeGetRequest(baseUrl + `getAdmins?id=${userID}`).then(async response => {
            if (response != null) {
                if (!response.error) {
                    var dataList = response.results;
                    console.log(dataList);
                    accountId = dataList.userData.id;
                    $('input[name=password]').prop("disabled", "disabled");
                    $('input[name=firstName]').val(dataList.userData.firstName);
                    $('input[name=lastName]').val(dataList.userData.lastName);
                    $('input[name=email]').val(dataList.userData.email);
                    $('input[name=nrcNumber]').val(dataList.nrcNumber);
                    $('input[name=phoneNumber]').val(dataList.userData.phoneNumber);
                    $('input[name=dob]').val(getDateValue(dataList.userData.dob));
                    $('input[name=province]').val(dataList.province);
                    $('input[name=district]').val(dataList.district);
                    getSelectValue("roleId", dataList.userData.rolesModel.title);
                    getSelectValue("gender", dataList.userData.gender);
                    getSelectValue("provinceId", dataList.provinceName);
                    getSelectValue("districtId", dataList.districtName);
                    await provinceChangeListener(dataList.district);
                }
            }
        });
    }

    async function submitForm() {
        $("#btnSpinner").removeClass('d-none');
        var formData = $('#formData').serializeArray().reduce(function (obj, item) {
            obj[item.name] = item.value;
            return obj;
        }, {});
        console.log(formData);

        @if (@Model.updateData)
        {
            @Html.Raw("await updateStaff(formData)");
        }
        else {
            @Html.Raw("await getStaffbyNrc(formData);");
        }
    }

    async function getStaffbyNrc(formData) {
        await makeGetRequest(baseUrl + `getAdminsByNrc?nrc=${formData.nrcNumber}`).then(async response => {
            if (response != null) {
                if (response.error) {
                    await createUserAccount(formData);
                } else {
                    $("#btnSpinner").addClass('d-none');
                    alertify.error('Staff Account already exists');
                }
            }
        });
    }

    async function createUserAccount(formData) {
        await makePostRequest(formData, baseUrl + "createUsers").then(async response => {
            console.log(response);
            if (response.error) {
                alertify.error('Unsuccessful - ' + response.errorMessage);
                console.log(response.errorMessage);
                $("#btnSpinner").addClass('d-none');
            } else {
                var id = response.results;
                alertify.success("User Profile Created, Sending Registration Email...");
                await sendMail(formData.email);
                await createStaff(id, formData)
            }
        });
    }

    async function createStaff(id, formData) {
        formData.adminId = id;
        await makePostRequest(formData, baseUrl + "createAdmins").then(async response => {
            console.log(response);
            if (response.error) {
                alertify.error('Unsuccessful - ' + response.errorMessage);
                console.log(response.errorMessage);
            } else {
                alertify.success("Admin Created");
            }
            $("#userResponse").fadeIn().removeClass('d-none');
        });
        $("#btnSpinner").addClass('d-none');
    }

    async function updateStaff(formData) {
        var userID = "@Model.userId";

        formData.id = accountId;
        await makePostRequest(formData, baseUrl + "updateUsers").then(async response => {
            console.log(response);
            if (response.error) {
                alertify.error('Unsuccessful - ' + response.errorMessage);
                console.log(response.errorMessage);
            } else {
                alertify.success("Account Updated");
            }
        });

        formData.id = userID;
        await makePostRequest(formData, baseUrl + "updateAdmins").then(async response => {
            console.log(response);
            if (response.error) {
                alertify.error('Unsuccessful - ' + response.errorMessage);
                console.log(response.errorMessage);
            } else {
                alertify.success("Admin Details Updated");
            }
        });
        $("#btnSpinner").addClass('d-none');
    }

    async function getProvinceData() {
        var locationData = $('#Location').val();
        console.log(locationData);

        await makeGetRequest(baseUrl + "getProvinces").then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#provinceId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
            }
        });

        var locationName = [];
        await makeGetRequest(baseUrl + "getByLocation?location=" + locationData).then(async response => {
            if (response != null) {
                var data = response.results;
                if (data != null) {
                    locationName = data.name.split("-");
                }
                console.log(locationName[2]);
                getSelectValue("provinceId", locationName[2]);
            }
        });
        await provinceChangeListener(locationName[1]);
    }

    async function provinceChangeListener(District) {
        $('#districtId').empty();
        $("#districtSpinner").removeClass('d-none');

        var provinceValue = document.getElementById("provinceId").value;
        await makeGetRequest(baseUrl + `getDistricts?provinceCode=${provinceValue}`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#districtId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                getSelectValue("districtId", District);
                await districtChangeListener();
            }
        });
        $('#Province').val(provinceValue);
        $("#districtSpinner").addClass('d-none');
    }

    async function districtChangeListener() {
        $('#sateliteId').empty();
        $("#sateliteSpinner").removeClass('d-none');

        var districtValue = document.getElementById("districtId").value;
        $('#District').val(districtValue);
        $("#sateliteSpinner").addClass('d-none');
    }
</script>
