    $(document).ready(async function () {
        var userRole = getCookie("userRole");

        if (userRole != "Admin") {
            window.location.href = "/Unauthorized";
        }
        await getProvinceData();
        displayMainBody();
    });

    async function getProvinceData() {
        await makeGetRequest(baseUrl + "getProvinces").then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#provinceId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await provinceChangeListener();
            }
        });
    }

    async function provinceChangeListener() {
        $('#districtId').empty();
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $("#districtSpinner").removeClass('d-none');

        var provinceValue = document.getElementById("provinceId").value;
        await makeGetRequest(baseUrl + `getDistricts?provinceCode=${provinceValue}`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#districtId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await districtChangeListener();
            }
        });
        $("#districtSpinner").addClass('d-none');
    }

    async function districtChangeListener() {
        $('#sateliteId').empty();
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $("#sateliteSpinner").removeClass('d-none');

        var districtValue = document.getElementById("districtId").value;
        await makeGetRequest(baseUrl + `getSatelites?disctrictCode=${districtValue}`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#sateliteId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await sateliteChangeListener();
            }
        });
        $("#sateliteSpinner").addClass('d-none');
    }

    async function sateliteChangeListener() {
        $("#deviceSpinner").removeClass('d-none');
        $('#dataTable').DataTable({ "bDestroy": true }).clear();

        var sateliteValue = document.getElementById("sateliteId").value;
        await makeGetRequest(baseUrl + `getStaffByLocation?location=${sateliteValue}`).then(response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];

                    $('#dataTable').DataTable({
                        "order": [[0, "desc"]],
                        "bDestroy": true
                    }).row.add([
                        dataList.id,
                        `${dataList.staffData.firstName} ${dataList.staffData.lastName}`,
                        `<label class="small">Email: <b>${dataList.staffData.email}</b></label> <br />
                         <label class="small">Phone Number: <b>${dataList.staffData.phoneNumber}</b></label> <br />
                         <label class="small">NRC-Number: <b>${dataList.nrcNumber}</b></label> <br />`,
                        dataList.staffData.gender,
                        getDateValue(dataList.staffData.dob),
                        `<label class="small">Code: <b>${dataList.location}</b></label>
                         <label class="small">Location: <b>${dataList.locationData.name}</b></label> `,
                        dataList.staffData.rolesModel.title,
                        `<p class="${getStatusColor(dataList.staffData.accountStatus.title)}">${dataList.staffData.accountStatus.title}</p>`,
                        `<div class="d-flex justify-content-between">
                            <a href='Staff/StaffCreation?userId=${dataList.id}' class="btn bg-transparent text-info w-100">Edit</a>
                            <button class="btn bg-transparent text-danger" onclick="deleteFunction('${dataList.id}')">Remove</button>
                        </div>`
                    ]).draw();
                }
            }
        });
        $("#deviceSpinner").addClass('d-none');
    }

