@page
@model Crop_Management_System.Pages.Farmers.IndexModel
@{
}

<div>
    <h4 class="mt-4">Farmer Members</h4>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active"><a href="@Url.Page("/Index")" class="ml-1 mr-1">Dashboard</a> / Farmers</li>
    </ol>

    @* Filters *@
    <div class="mb-4">
        <div class="row">
            <div class="col-md-6">
                <a href="@Url.Page("/Views/Farmers/FarmerCreation")"
                   class="btn btn-primary w-100 font-weight-bold">Add Farmer</a>
            </div>
            <div class="col-md-6">
                <a class="btn btn-outline-info w-100" data-toggle="collapse" href="#globalSearch" role="button" aria-expanded="false"
                   aria-controls="locationFilter">
                    Global Search
                    <i class="icofont-dotted-down"></i>
                </a>
            </div>
            <div class="col-md-12 mt-4 d-none">
                <a class="btn btn-outline-primary w-100" data-toggle="collapse" href="#locationFilter" role="button" aria-expanded="false"
                   aria-controls="locationFilter">
                    Location Filter
                    <i class="icofont-dotted-down"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <div id="locationFilter" class="collapse border border-primary rounded p-3">
            <div class="row">
                <div class="col-md-15">
                    <label class="font-weight-bold">Farmer Location<i class="icofont-dotted-down"></i></label>
                    <select class="form-control " name="provinceId" id="provinceId" onchange="provinceChangeListener()" required>
                    </select>
                </div> 
            </div>
        </div>
        <div id="globalSearch" class="collapse border border-info rounded p-3 mt-4">
            <div class="row  ">
                <div class="col-md-15">
                    <label class="font-weight-bold">Farmer NRC</label>
                    <input id="farmerNRC" type="text" class="form-control" value="" placeholder="000000/00/0" />
                </div>
                <div class="col-md-12 mt-4">
                    <button onclick="gloablSearch()" class="btn btn-info w-100">SEARCH FOR FARMER</button>
                </div>
            </div>
        </div>
    </div>

    <!-- database table -->
    <div class="mt-4 card mb-4">
        <div class="card-header">
            <i class="fas fa-table mr-1"></i>
            Current Farmers
            <span id="tableSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Personal Information</th>
                            <th>Contact Information</th>
                            <th>Location</th>
                            <th>Account Details</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableData" class=""></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    var url;

    $(document).ready(async function () {
        await getData();
        await getLocation();
        displayMainBody();
    });

    async function getLocation() {
        await makeGetRequest(baseUrl + "getProvinces").then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#provinceId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
            }
        });
    }

    async function provinceChangeListener() { 
        var provinceValue = document.getElementById("provinceId").value;
        await getData(provinceValue);
    }

    async function getData(location) {
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        var url = baseUrl + `getAllFarmer`;
        if (location != null) {
            url = baseUrl + `getFarmerByLocation?location=${location}&page=1`;
        }

        console.log(url);

        await makeGetRequest(url).then(response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#dataTable').DataTable({
                        "order": [[0, "desc"]],
                        "bDestroy": true,
                        "drawCallback": function (settings) {
                            var api = this.api();
                            // Output the data for the visible rows to the browser's console
                            //console.log(api.rows({ page: 1 }).data());
                        }
                    }).row.add([
                        dataList.id,
                        `<label class="small">Name: <b>${dataList.names}</b></label> <br />
                         <label class="small">Gender: <b>${dataList.gender}</b></label> <br />`,
                        `<label class="small">Phone Number: <b>${dataList.phoneNumber}</b></label> <br />
                         <label class="small">NRC-Number: <b>${dataList.nrcNumber}</b></label> <br />`,
                        `<label class="small">Province: <b>${dataList.province.trim()}</b></label> <br />
                         <label class="small">District: <b>${dataList.district.trim()}</b></label> <br />`,
                        `<label class="small">Verified: <b>${highlightStatus(dataList.verified)}</b></label> <br />
                         <label class="small">Created By: <b>${dataList.createdBy}</b></label> <br />`,
                        `<div class="d-flex justify-content-between">
                            <a href='Farmers/FarmerCreation?userId=${dataList.id}' class="btn bg-transparent text-info w-100">Edit</a>
                            <button class="btn bg-transparent text-danger" onclick="deleteFunction('${dataList.id}')">Remove</button>
                        </div>`
                    ]).draw();
                }
            }
        });
    }

    async function gloablSearch() {
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $('#dataTable').DataTable({ "bDestroy": true }).clear();

        $("#tableSpinner").removeClass('d-none');
        var nrc = $('#farmerNRC').val();
        await makeGetRequest(baseUrl + `getFarmerByNrc?nrc=${nrc.trim()}`).then(response => {
            if (response != null) {
                if (!response.error) {
                    var dataList = response.results;
                    $('#dataTable').DataTable({
                        "order": [[0, "desc"]],
                        "bDestroy": true,
                    }).row.add([
                        dataList.id,
                        `<label class="small">Name: <b>${dataList.names}</b></label> <br />
                         <label class="small">Gender: <b>${dataList.gender}</b></label> <br />`,
                        `<label class="small">Phone Number: <b>${dataList.phoneNumber}</b></label> <br />
                         <label class="small">NRC-Number: <b>${dataList.nrcNumber}</b></label> <br />`,
                        `<label class="small">Province: <b>${dataList.province}</b></label> <br />
                         <label class="small">District: <b>${dataList.district}</b></label> <br />`,
                        `<label class="small">Verified: <b>${highlightStatus(dataList.verified)}</b></label> <br />
                         <label class="small">Created By: <b>${dataList.createdBy}</b></label> <br />`,
                        `<div class="d-flex justify-content-between">
                            <a href='Farmers/FarmerCreation?userId=${dataList.id}' class="btn bg-transparent text-info w-100">Edit</a>
                            <button class="btn bg-transparent text-danger" onclick="deleteFunction('${dataList.id}')">Remove</button>
                        </div>`
                    ]).draw();
                }
            }
        });

        $("#tableSpinner").addClass('d-none');
    }

    async function deleteFunction(id) {
        var confirmText = "Are you sure you want to delete this device?";
        if (confirm(confirmText)) {
            await makeGetRequest(baseUrl + `deleteFarmer?id=${id}`).then(async response => {
                if (response != null) {
                    console.log(response);
                    if (response.error) {
                        alertify.error("Failed to Delete Staff");
                    } else {
                        alertify.success("Farmer Successfuly Deleted");
                        $('#dataTable').DataTable({ "bDestroy": true }).clear();
                        await getData();
                    }
                }
            });
        }
    }

    function highlightStatus(val) {
        if (val == true) {
            return '<i class="text-success">TRUE</i>'
        } else {
            return '<i class="text-danger">FALSE</i>'
        }
    }
</script>

