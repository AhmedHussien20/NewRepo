@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div>
    <h4 class="mt-4">Dashboard</h4>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Dashboard</li>
    </ol>

    <!-- colored cards stats -->
    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <!-- fetch user# -->
                    <h4>Transactions</h4>
                    <span class="font-weight-bold" id="transNum">00<br>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <h4>Farmers</h4>
                    <span class="font-weight-bold" id="farnNums">00<br>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white mb-4">
                <div class="card-body">
                    <h5>Total Bags & Metric Tones</h5>
                    <span class="font-weight-bold" id="deviceNum">00<br>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <h4>Crop Value</h4>
                    <span id="revenuNum"><b>00</b><br>
                </div>
            </div>
        </div>
    </div>

    @* Filters *@
    <div class="mb-4">
        <div class="row">
            <div class="col-md-6">
                <a onclick="getProvinceData()" class="btn btn-outline-primary w-100" data-toggle="collapse" href="#locationFilter" role="button" aria-expanded="false"
                   aria-controls="locationFilter">
                    <h5>
                        Location & Crop Filter
                        <i class="icofont-dotted-down"></i>
                    </h5>
                </a>
            </div>
            <div class="col-md-6">
                <a class="btn btn-outline-primary w-100" data-toggle="collapse" href="#dateFilter" role="button" aria-expanded="false"
                   aria-controls="dateFilter">
                    <h5>
                        Date Filter
                        <i class="icofont-dotted-down"></i>
                    </h5>
                </a>
            </div>
        </div>
    </div>

    @* Location Filter *@
    <div class="mb-4">
        <div id="locationFilter" class="collapse border border-info rounded p-3">
            <div>
                <div class="row">
                    <div class="col-md-4">
                        <label class="font-weight-bold">Province <i class="icofont-dotted-down"></i></label>
                        <select class="form-control " name="provinceId" id="provinceId" onchange="provinceChangeListener()" required>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="font-weight-bold">
                            <span id="districtSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                            District
                            <i class="icofont-dotted-down"></i>
                        </label>
                        <select class="form-control" name="districtId" id="districtId" onchange="districtChangeListener()" required>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="font-weight-bold">
                            <span id="sateliteSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                            Satellite
                            <i class="icofont-dotted-down"></i>
                        </label>
                        <select class="form-control" name="SateliteId" id="sateliteId" onchange="sateliteChangeListener()" required>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="font-weight-bold">CROP<i class="icofont-dotted-down"></i></label>
                        <select class="form-control " name="cropId" id="cropId" onchange="sateliteChangeListener()" required>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Date Filter *@
    <div class="mb-4">
        <div id="dateFilter" class="collapse border border-info rounded p-3">
            <div class="row  ">
                <div class="col-md-6">
                    <label class="font-weight-bold">Start Date <i class="icofont-dotted-down"></i></label>
                    <input id="startDate" type="date" class="form-control" value="" />
                </div>
                <div class="col-md-6">
                    <label class="font-weight-bold">
                        <span class="d-none spinner-border"></span>
                        End Date
                        <i class="icofont-dotted-down"></i>
                    </label>
                    <input id="endDate" type="date" class="form-control" value="" />
                </div>
                <div class="col-md-12 mt-4">
                    <button onclick="dateFilter()" class="btn btn-outline-primary w-100">Filter</button>
                </div>
            </div>
        </div>
    </div>

    <!-- charts -->
    <div class="row">
        <!-- sold products -->
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-area mr-1"></i>
                    Transactions per Month <i class="small">(No. Bags)</i>
                </div>
                <div class="card-body"><canvas id="monthRecords" width="100%" height="40"></canvas></div>
            </div>
        </div>

        <!-- best selling products -->
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar mr-1"></i>
                    Transactions for past Week <i class="small">(No. Bags)</i>
                </div>
                <div class="card-body"><canvas id="weekRecords" width="100%" height="40"></canvas></div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar mr-1"></i>
                    Satellite Transactions <i class="small">(No. Bags)</i>
                </div>
                <div class="card-body"><canvas id="stationRecords" width="100%" height="40"></canvas></div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar mr-1"></i>
                    Most Purchased Crops
                </div>
                <div class="card-body"><canvas id="cropRecords" width="100%" height="40"></canvas></div>
            </div>
        </div>
    </div>

    <!-- database table -->
