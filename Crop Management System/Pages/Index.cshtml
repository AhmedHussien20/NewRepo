    function getMonth(num) {
        var month;
        switch (num) {
            case 1:
                month = "January"
                break;
            case 2:
                month = "February"
                break;
            case 3:
                month = "March"
                break;
            case 4:
                month = "April"
                break;
            case 5:
                month = "May"
                break;
            case 6:
                month = "June"
                break;
            case 7:
                month = "July"
                break;
            case 8:
                month = "August"
                break;
            case 9:
                month = "September"
                break;
            case 10:
                month = "October"
                break;
            case 11:
                month = "November"
                break;
            case 12:
                month = "December"
                break;
        }
        return month;
    }

    function getDay(num) {
        var month;
        console.log(num);
        switch (num) {
            case "1":
                month = "Sun"
                break;
            case "2":
                month = "Mon"
                break;
            case "3":
                month = "Tue"
                break;
            case "4":
                month = "Wed"
                break;
            case "5":
                month = "Thur"
                break;
            case "6":
                month = "Fri"
                break;
            case "7":
                month = "Sat"
        }
        return month;
    }


    //date Filter
    async function dateFilter() {
        var startDate = $('#startDate').val();
        var endDate = $('#endDate').val();
        //$('#dataTable').DataTable({ "bDestroy": true }).clear();
        var provinceValue = document.getElementById("provinceId").value;
        var districtValue = document.getElementById("districtId").value;
        var sateliteValue = document.getElementById("sateliteId").value;
        var startDate = $('#startDate').val();
        var endDate = $('#endDate').val();
        var cropId = document.getElementById("cropId").value;

        if (startDate == "") {
            startDate = new Date(2021, 0, 1).toISOString();
            endDate = new Date(9999, 0, 1).toISOString()
        }

        await getStats(provinceId = provinceValue, districtId = districtValue, satelliteId = sateliteValue,
            startDateFilter = startDate, endDateFilter = endDate, shouldFilter = true, cropId);
        await generateCharts(provinceId = provinceValue, districtId = districtValue, satelliteId = sateliteValue,
            startDateFilter = startDate, endDateFilter = endDate, shouldFilter = true, cropId);
    }

    async function getProvinceData() {
        await makeGetRequest(baseUrl + `getAllCrops`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#cropId').append($('<option>', {
                        value: dataList.fmtitemno,
                        text: dataList.title,
                    }));
                }
            }
        });

        await makeGetRequest(baseUrl + "getProvinces").then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#provinceId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await provinceChangeListener();
            }
        });
    }

    async function provinceChangeListener() {
        $('#districtId').empty();
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $("#districtSpinner").removeClass('d-none');

        var provinceValue = document.getElementById("provinceId").value;
        await makeGetRequest(baseUrl + `getDistricts?provinceCode=${provinceValue}`).then(async response => {
            if (response != null) {
                $('#districtId').append($('<option>', {
                    value: null,
                    text: null,
                }));
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#districtId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await districtChangeListener();
            }
        });
        $("#districtSpinner").addClass('d-none');
    }

    async function districtChangeListener() {
        $('#sateliteId').empty();
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $("#sateliteSpinner").removeClass('d-none');

        var districtValue = document.getElementById("districtId").value;
        await makeGetRequest(baseUrl + `getSatelites?disctrictCode=${districtValue}`).then(async response => {
            if (response != null) {
                $('#sateliteId').append($('<option>', {
                    value: null,
                    text: null,
                }));
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#sateliteId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await sateliteChangeListener();
            }
        });
        $("#sateliteSpinner").addClass('d-none');
    }

    async function sateliteChangeListener() {
        $("#deviceSpinner").removeClass('d-none');
        $('#dataTable').DataTable({ "bDestroy": true }).clear();

        var provinceValue = document.getElementById("provinceId").value;
        var districtValue = document.getElementById("districtId").value;
        var sateliteValue = document.getElementById("sateliteId").value;
        var cropId = document.getElementById("cropId").value;
        var startDate = $('#startDate').val();
        var endDate = $('#endDate').val();

        if (startDate == "") {
            startDate = new Date(2021, 0, 1).toISOString();
            endDate = new Date(9999, 0, 1).toISOString()
        }

        await getStats(provinceId = provinceValue, districtId = districtValue, satelliteId = sateliteValue,
            startDateFilter = startDate, endDateFilter = endDate, shouldFilter = true, cropId);
        await generateCharts(provinceId = provinceValue, districtId = districtValue, satelliteId = sateliteValue,
            startDateFilter = startDate, endDateFilter = endDate, shouldFilter = true, cropId);
        $("#deviceSpinner").addClass('d-none');
    }
    //end of date filter
</script>


