    function highlightStatus(val, index) {
        if (val == 'Pending') {
            return `<i class="text-warning" id='status_${index}'>${val}</i>`
        } else if (val == 'Approved') {
            return `<i class="text-success" id='status_${index}'>${val}</i>`
        } else if (val == 'Posted') {
            return `<i class="text-secondary" id='status_${index}'>${val}</i>`
        } else if (val == 'Retract') {
            return `<i class="text-danger" id='status_${index}'>${val}</i>`
        } else {
            return `<i class="text-info" id='status_${index}'>${val}</i>`
        }
    }

    function checkIfValid(val, retractedAmount, status) {
        status = status.toLowerCase();
        if (status == "retract") {
            return `<p class="text-danger"><del>${converToMoneyFormat(retractedAmount)}</del></p>
                                                    <p class="text-danger">${converToMoneyFormat(0)}</p>`;
        } else {
            return ` <p class="text-success">${converToMoneyFormat(val)}</p>`;
        }
    }

