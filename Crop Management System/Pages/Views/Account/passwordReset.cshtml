@page
@model Crop_Management_System.Pages.Views.Authorisation.passwordResetModel
@{
    Layout = null;
}

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    @*CSS*@
    <link rel="stylesheet" href="~/css/site.css" />

    @*dark theme*@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @*icofont*@
    <link rel="stylesheet" href="~/lib/icofont/icofont.min.css" />

    @*alertify*@
    <script src="~/lib/alertifyjs/alertify.min.js"></script>
    <link href="~/lib/alertifyjs/css/alertify.min.css" rel="stylesheet" />
    <link href="~/lib/alertifyjs/css/themes/default.min.css" rel="stylesheet" />
</head>

<body class="bg-light">
    <div id="layoutAuthentication">
        <div id="layoutAuthentication_content">
            <main>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-5">
                            <div class="card shadow-lg border-0 rounded-lg mt-5">
                                <div class="text-center card-header">
                                    <div>
                                        <img src="~/images/fra-logo.png" width="300" height="100" alt="No Image Found" />
                                    </div>
                                    <div>
                                        <h3 class="font-weight-light my-4">Password Reset</h3>
                                    </div>
                                </div>
                                @if (Model.hasError)
                                {
                                    <div class="" id="errorMessage">
                                        <h5 class="text-danger p-4 text-center">
                                            @Model.message
                                        </h5>
                                    </div>
                                }
                                <div class="card-body">
                                    @* Send Account Reset Code *@
                                    @if (Model.accountReset && Model.key == null)
                                    {
                                        <p class="text-center text-muted">A Password Reset link will be sent to the entered email address</p>
                                        <form method="post">
                                            <div class="form-group">
                                                <label class="small mb-1" for="inputEmailAddress">Email Address</label>
                                                <input id="merchantCode" name="email" class="form-control py-4" type="email"
                                                       placeholder="Enter Email" value="" required />
                                            </div>
                                            <button onclick="btnSubmit()" class="btn btn-primary w-100" id="log_smt_btn" type="submit">
                                                <span id="btnSpinner" class="d-none spinner-border  spinner-grow-sm" role="status" aria-hidden="true"></span>
                                                Send Reset Link
                                            </button>
                                        </form>
                                    }

                                    @* Reset Password *@
                                    @if (Model.accountReset && Model.key != null)
                                    {
                                        <form method="post">
                                            <div class="form-group">
                                                <label class="small mb-1" for="inputPassword">New Password</label>
                                                <input id="secretCode" name="newPassword" class="form-control py-4" type="password"
                                                       placeholder="Enter New Password" minlength="7" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                                                       title="Must contain at least one number and one uppercase and lowercase letter,
                                           and at least 8 or more characters" required autocomplete="off" />
                                            </div>
                                            <div class="form-group">
                                                <label class="small mb-1" for="inputPassword">Confirm Password</label>
                                                <input id="secretCode" name="confirmNewPassword" class="form-control py-4" type="password"
                                                       placeholder="Confirm New Password" minlength="7" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                                                       title="Must contain at least one number and one uppercase and lowercase letter,
                                           and at least 8 or more characters" required autocomplete="off" />
                                            </div>
                                            <button onclick="btnSubmit()" class="btn btn-primary w-100" id="log_smt_btn" type="submit">
                                                <span id="btnSpinner" class="d-none spinner-border  spinner-grow-sm" role="status" aria-hidden="true"></span>
                                                Reset Password
                                            </button>
                                        </form>
                                    }

                                    @* Change Default Password *@
                                    @if (!Model.accountReset && Model.key == null)
                                    {
                                        <form method="post">
                                            <div class="form-group">
                                                <label class="small mb-1" for="inputEmailAddress">Default/Old Password</label>
                                                <input id="merchantCode" name="defaultPasswoord" class="form-control py-4" type="password"
                                                       placeholder="Enter Default Password" required />
                                            </div>
                                            <div class="form-group">
                                                <label class="small mb-1" for="inputPassword">New Password</label>
                                                <input id="secretCode" name="newPassword" class="form-control py-4" type="password"
                                                       placeholder="Enter New Password" minlength="7" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                                                       title="Must contain at least one number and one uppercase and lowercase letter,
                                           and at least 8 or more characters" required autocomplete="off" />
                                            </div>
                                            <div class="form-group">
                                                <label class="small mb-1" for="inputPassword">Confirm Password</label>
                                                <input id="secretCode" name="confirmNewPassword" class="form-control py-4" type="password"
                                                       placeholder="Confirm New Password" minlength="7" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                                                       title="Must contain at least one number and one uppercase and lowercase letter,
                                           and at least 8 or more characters" required autocomplete="off" />
                                            </div>
                                            <button onclick="btnSubmit()" class="btn btn-primary w-100" id="log_smt_btn" type="submit">
                                                <span id="btnSpinner" class="d-none spinner-border  spinner-grow-sm" role="status" aria-hidden="true"></span>
                                                Reset Password
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    function btnSubmit() {
        spinnerHandler('btnSpinner');
    }
</script>
