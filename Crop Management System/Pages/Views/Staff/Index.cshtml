    function editModel(index) {
        var table = $('#dataTable').DataTable();

        //get data
        var id = table.row(index).data()[0];
        var deviceBearer = table.row(index).data()[2];
        var dateActivated = table.row(index).data()[3];
        var lastSync = table.row(index).data()[4];
        var status = table.row(index).data()[5];

        //add data
        $('input[name=deviceID]').val(id);
        $('input[name=deviceBearer]').val(deviceBearer);
        $('input[name=deviceStatus]').val(status);

        //display model
        $('#modal').modal('show');
    }

    async function editForm() {
        $("#btnSpinner").removeClass('d-none');
        var formData = $('#formData').serializeArray().reduce(function (obj, item) {
            obj[item.name] = item.value;
            return obj;
        }, {});
        console.log(formData);
        await simulateAsycCall();

        //update record in table
        var table = $('#dataTable').DataTable();
        table.row(formData.id).data([
            "Tiger Nixon",
            "System Architect",
            "$3,120",
            "2011/04/25",
            "Edinburgh",
            "5421",
            "Tiger Nixon",
            "System Architect",
            "$3,120",
        ]).draw();

        $("#btnSpinner").addClass('d-none');
        $('#modal').modal('hide');
        alertify.success("Record Updated");
    }

    async function deleteFunction(id) {
        var confirmText = "Are you sure you want to delete this device?";
        if (confirm(confirmText)) {
            await makeGetRequest(baseUrl + `deleteStaff?id=${id}`).then(async response => {
                if (response != null) {
                    console.log(response);
                    if (response.error) {
                        alertify.error("Failed to Delete Staff");
                    } else {
                        alertify.success("Staff Successfuly Deleted");
                        $('#dataTable').DataTable({ "bDestroy": true }).clear();
                        await getData();
                    }
                }
            });
        }
    }
</script>
