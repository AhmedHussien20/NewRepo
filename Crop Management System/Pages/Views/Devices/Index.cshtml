@page
@model Crop_Management_System.Pages.Devices.IndexModel
@{
}

<div>
    <h4 class="mt-4">Devices</h4>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active"><a href='@Url.Action("Index","Home")' class="ml-1 mr-1">Dashboard</a> / Devices</li>
    </ol>

    <!-- colored cards stats -->
    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <!-- fetch user# -->
                    <h4>Devices</h4>
                    <span class="font-weight-bold" id="deviceCount">00<br>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <h4>Online Devices</h4>
                    <span class="font-weight-bold" id="onlineDevices">00<br>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white mb-4">
                <div class="card-body">
                    <h4>Deactivated Devices</h4>
                    <span class="font-weight-bold" id="deactiveDevices">00<br>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <h4>Devices On Hold</h4>
                    <span id="devicesOnHold"><b>00</b><br>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <div class="row">
            <div class="col-md-6">
                <a asp-area="" asp-page="/Views/Devices/DeviceRegistration" class="btn btn-primary w-100 font-weight-bold">Add Device</a>
            </div>
            <div class="col-md-6">
                <a onclick="getProvinceData2()" class="btn btn-outline-info w-100" data-toggle="collapse" href="#globalSearch" role="button" aria-expanded="false"
                   aria-controls="locationFilter">
                    Location Filter
                    <i class="icofont-dotted-down"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <div id="globalSearch" class="collapse border border-info rounded p-3">
            <div class="row">
                <div class="col-md-4">
                    <label class="font-weight-bold">Province <i class="icofont-dotted-down"></i></label>
                    <select class="form-control " name="provinceId2" id="provinceId2" onchange="provinceChangeListener2()" required>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="font-weight-bold">
                        <span id="districtSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                        District
                        <i class="icofont-dotted-down"></i>
                    </label>
                    <select class="form-control" name="districtId2" id="districtId2" onchange="districtChangeListener2()" required>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="font-weight-bold">
                        <span id="sateliteSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                        Satellite
                        <i class="icofont-dotted-down"></i>
                    </label>
                    <select class="form-control" name="SateliteId2" id="sateliteId2" onchange="sateliteChangeListener2()" required>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- database table -->
    <div class="mt-4 card mb-4">
        <div class="card-header">
            <i class="fas fa-table mr-1"></i>
            Current Devices
            <span id="tableSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Device ID</th>
                            <th>Prefix</th>
                            <th>Device Name</th>
                            <th>SerialNumber</th>
                            <th>Location Data</th>
                            <th>Created By</th>
                            <th>Created On</th>
                            <th>Modified By</th>
                            <th>Modified On</th>
                            <th>Buyer</th>
                            <th>Inspector</th>
                            <th>Status</th>
                            <th>SyncPeriod</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableData" class=""></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="modal" class="modal fade ModelDialog" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <iframe name="dFrame" id="dummyframe" style="display: none;"></iframe>
            <form id="formData" target="dFrame" onsubmit="editForm()" enctype="multipart/form-data">
                <input type="hidden" name="Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Device Modal</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <div>
                            <h5>Location Information</h5>
                            <hr />
                            <div class=" ">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="font-weight-bold">Province <i class="icofont-dotted-down"></i></label>
                                        <select class="form-control " name="provinceId" id="provinceId" onchange="provinceChangeListener()" required>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="font-weight-bold">
                                            <span id="districtSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                                            District
                                            <i class="icofont-dotted-down"></i>
                                        </label>
                                        <select class="form-control" name="districtId" id="districtId" onchange="districtChangeListener()" required>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="font-weight-bold">
                                            <span id="sateliteSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                                            Satellite
                                            <i class="icofont-dotted-down"></i>
                                        </label>
                                        <select class="form-control" name="SateliteId" id="sateliteId" onchange="sateliteChangeListener()" required>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <h5 class="mt-4">Device Information</h5>
                            <hr />
                            <div class="">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="font-weight-bold">Device ID</label>
                                        <input type="text" class="form-control" name="DeviceId" id="deviceID" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="font-weight-bold">Device Serial Number</label>
                                        <input type="text" class="form-control" name="SerialNumber" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="font-weight-bold">Device Name</label>
                                        <input type="text" class="form-control" name="Title" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="font-weight-bold">Device Status <i class="icofont-dotted-down"></i></label>
                                        <select class="form-control" name="DeviceStatusId" id="deviceStatusId">
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="font-weight-bold">Buyer <i class="icofont-dotted-down"></i></label>
                                        <select class="form-control" name="DeviceBearerId" id="deviceBearerId">
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="font-weight-bold">Inspector <i class="icofont-dotted-down"></i></label>
                                        <select class="form-control" name="DeviceSupervisorId" id="DeviceSupervisorId">
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="font-weight-bold">Location</label>
                                        <input type="text" class="form-control" name="Location" id="Location" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="font-weight-bold">Sync Period <i class="icofont-dotted-down"></i></label>
                                        <div class="input-group">
                                            <input type="text" class="form-control" name="SyncPeriod" id="SyncPeriod" required>
                                            <span class="input-group-text" disabled>Minutes</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button id="btnEdit" type="submit" class="btn btn-primary">
                        <span id="btnSpinner" class="d-none spinner-border  spinner-grow-sm" role="status" aria-hidden="true"></span>
                        Save changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    var deviceIdValue = ["", "", "", ""];
    var url;
    var username = "";

    $(document).ready(async function () {
        username = getCookie("userName");
        await getData("");
        await getStats();
        displayMainBody();
    });

    async function getStats() {
        await makeGetRequest(baseUrl + `getDeviceStats`).then(response => {
            if (response != null) {
                var dataList = response.results;
                $('#deviceCount').html(dataList.deviceCount);
                $('#onlineDevices').html(dataList.activeDevices);
                $('#deactiveDevices').html(dataList.deactiveDevices);
                $('#devicesOnHold').html(dataList.devicesOnHold);
            }
        });
    }

    async function getData(sateliteValue) {
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $("#tableSpinner").removeClass('d-none');
        var url = "getAllDevices";
        url = "getDeviceByLocation?location=" + sateliteValue;
        //if (sateliteValue != null) {
        //    url = "getDeviceByLocation?location="+sateliteValue;
        //}

        console.log(url);

        await makeGetRequest(baseUrl + url).then(response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    var bearerEmail;
                    var supervisorEmail;
                    var deviceStatus;
                    var location;

                    if (dataList.deviceBearerData != null) {
                        bearerEmail = dataList.deviceBearerData.email;
                    } else {
                        bearerEmail = `<p class="text-danger">UNSET</p>`;
                    }
                    if (dataList.deviceSuperevisorData != null) {
                        supervisorEmail = dataList.deviceSuperevisorData.email;
                    } else {
                        supervisorEmail = `<p class="text-danger">UNSET</p>`;
                    }

                    if (dataList.deviceStatusData != null) {
                        var statusColor = getStatusColor(dataList.deviceStatusData.title);
                        deviceStatus = `<p class="${statusColor}">${dataList.deviceStatusData.title}</p>`
                    } else {
                        deviceStatus = `<p class="text-danger">UNSET</p>`
                    }

                    if (dataList.netPurLocationModel != null) {
                        location = dataList.location
                    } else {
                        location = `<p class="text-danger">UNSET</p>`
                    }

                    $('#dataTable').DataTable({
                        "order": [[0, "desc"]],
                        "bDestroy": true,
                    }).row.add([
                        dataList.id,
                        dataList.deviceId,
                        dataList.prefix,
                        dataList.title,
                        dataList.serialNumber,
                        location,
                        dataList.createdBy,
                        convertTimeStampToDate(dataList.dateCreated),
                        dataList.modifiedBy,
                        convertTimeStampToDate(dataList.dateModified),
                        bearerEmail,
                        supervisorEmail,
                        deviceStatus,
                        dataList.syncPeriod,
                        `<div class="d-flex justify-content-around">
                            <button class="btn bg-transparent text-info" onclick="editModel('${i}')">View</button>
                            
                        </div>`,
                    ]).draw();
                    /*<button class="btn bg-transparent text-danger" onclick="deleteFunction('${dataList.id}')">Remove</button>*/
                }
            }
        });
        $("#tableSpinner").addClass('d-none');
    }

    async function deleteFunction(id) {
        var confirmText = "Are you sure you want to delete this device?";
        if (confirm(confirmText)) {
            await makeGetRequest(baseUrl + `deleteDevices?id=${id}`).then(async response => {
                if (response != null) {
                    console.log(response);
                    if (response.error) {
                        alertify.error("Failed to Delete Device");
                    } else {
                        alertify.success("Device Successfuly Deleted");
                        $('#dataTable').DataTable({ "bDestroy": true }).clear();
                        await getData();
                    }
                }
            });
        }
    }

    async function editModel(index) {
        var table = $('#dataTable').DataTable();

        //get data
        var Id = table.row(index).data()[0];
        var DeviceId = table.row(index).data()[1];
        var Title = table.row(index).data()[3];
        var SerialNumber = table.row(index).data()[4];
        var deviceBearer = table.row(index).data()[10];
        var deviceSuper = table.row(index).data()[11];
        var locationData = table.row(index).data()[5];
        var status = table.row(index).data()[12];
        var syncPeriod = table.row(index).data()[13];

        //display model
        await getNeededData(locationData);

        ////add data
        $('input[name=Id]').val(Id);
        $('input[name=DeviceId]').val(DeviceId);
        $('input[name=SerialNumber]').val(SerialNumber);
        $('input[name=Title]').val(Title);
        $('input[name=SyncPeriod]').val(syncPeriod);

        getSelectValue("deviceBearerId", deviceBearer.trim());
        getSelectValue("DeviceSupervisorId", deviceBearer.trim());

        $('#modal').modal('show');
    }

    async function getNeededData(locationData) {
        $('#deviceStatusId').empty();

        await makeGetRequest(baseUrl + `getAllDeviceStatus`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#deviceStatusId').append($('<option>', {
                        value: dataList.id,
                        text: dataList.title,
                    }));
                }
            }
        });

        await getStaffData(locationData);

        await getProvinceData(locationData);
    }

    async function getStaffData(locationData) {
        $('#deviceBearerId').empty();
        $('#DeviceSupervisorId').empty();

        await makeGetRequest(baseUrl + `getStaffByLocation?Location=` + locationData).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#deviceBearerId').append($('<option>', {
                        value: dataList.staffId,
                        text: `${dataList.staffData.email} - [${dataList.staffData.firstName} ${dataList.staffData.lastName}]`
                    }));
                    $('#DeviceSupervisorId').append($('<option>', {
                        value: dataList.staffId,
                        text: `${dataList.staffData.email} - [${dataList.staffData.firstName} ${dataList.staffData.lastName}]`
                    }));
                }
            }
        });
    }

    async function getProvinceData(locationData) {
        $('#provinceId').empty();

        await makeGetRequest(baseUrl + "getProvinces").then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#provinceId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
            }
        });

        //fetch current location details
        var locationName = [];
        await makeGetRequest(baseUrl + "getByLocation?location=" + locationData).then(async response => {
            if (response != null) {
                var data = response.results;
                if (data != null) {
                    locationName = data.name.split("-");
                }
                getSelectValue("provinceId", locationName[2]);
                console.log(locationData);
                console.log(locationName[2]);
            }
        });
        await provinceChangeListener(locationName[1], locationName[0]);
    }

    async function provinceChangeListener(District, Satellite) {
        $('#districtId').empty();
        $("#districtSpinner").removeClass('d-none');

        var provinceValue = document.getElementById("provinceId").value;
        deviceIdValue.splice(0, 1, provinceValue);

        await makeGetRequest(baseUrl + `getDistricts?provinceCode=${provinceValue}`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#districtId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                getSelectValue("districtId", District);
                await districtChangeListener(Satellite);
            }
        });
        $("#districtSpinner").addClass('d-none');
    }

    async function districtChangeListener(Satellite) {

        $('#sateliteId').empty();
        $("#sateliteSpinner").removeClass('d-none');

        var districtValue = document.getElementById("districtId").value;
        var districtData = districtValue.split(",");
        deviceIdValue.splice(1, 1, districtData[1]);

        var districtValue = document.getElementById("districtId").value;
        deviceIdValue.splice(1, 1, districtValue);

        await makeGetRequest(baseUrl + `getSatelites?disctrictCode=${districtValue}`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#sateliteId').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                getSelectValue("sateliteId", Satellite);
                await sateliteChangeListener();
            }
        });
        $("#sateliteSpinner").addClass('d-none');
    }

    async function sateliteChangeListener() {
        var num = 1;
        $("#deviceSpinner").removeClass('d-none');

        var sateliteValue = document.getElementById("sateliteId").value;
        deviceIdValue.splice(2, 1, sateliteValue);

        $("#deviceSpinner").addClass('d-none');
        //deviceIdValue.splice(3, 1, num);
        $('#Location').val(sateliteValue);
        await getStaffData(sateliteValue);
    }

    async function editForm() {
        $("#btnSpinner").removeClass('d-none');
        var formData = $('#formData').serializeArray().reduce(function (obj, item) {
            obj[item.name] = item.value;
            return obj;
        }, {});

        formData.SateliteId = formData.SateliteId.split(",")[0];
        formData.districtId = formData.districtId.split(",")[0];
        formData.provinceId = formData.provinceId.split(",")[0];
        formData.modifiedBy = username;
        formData.username = username;
        console.log(formData);

        await makePostRequest(formData, baseUrl + "updateDevices").then(async response => {
            console.log(response);
            if (response.error) {
                alertify.error('Unsuccessful - ' + response.errorMessage);
                console.log(response.errorMessage);
            } else {
                alertify.success("Device Updated");
                $('#dataTable').DataTable({ "bDestroy": true }).clear();
                await sateliteChangeListener();
                await getStats();
                await getData();
            }
        });

        $("#btnSpinner").addClass('d-none');
        $('#modal').modal('hide');
    }

    //location filter
    async function getProvinceData2() {
        $('#provinceId2').empty();

        $('#provinceId2').append($('<option>', {
            value: null,
            text: "Unset",
        }));
        await makeGetRequest(baseUrl + "getProvinces").then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#provinceId2').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await provinceChangeListener2();
            }
        });
    }

    async function provinceChangeListener2() {
        $('#districtId2').empty();
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $("#districtSpinner").removeClass('d-none');

        var provinceValue = document.getElementById("provinceId2").value;
        $('#districtId2').append($('<option>', {
            value: null,
            text: "Unset",
        }));
        await makeGetRequest(baseUrl + `getDistricts?provinceCode=${provinceValue}`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#districtId2').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await districtChangeListener2();
            }
        });
        $("#districtSpinner").addClass('d-none');
    }

    async function districtChangeListener2() {
        $('#sateliteId2').empty();
        $('#dataTable').DataTable({ "bDestroy": true }).clear();
        $("#sateliteSpinner").removeClass('d-none');

        var districtValue = document.getElementById("districtId2").value;
        $('#sateliteId2').append($('<option>', {
            value: null,
            text: "Unset",
        }));
        await makeGetRequest(baseUrl + `getSatelites?disctrictCode=${districtValue}`).then(async response => {
            if (response != null) {
                for (i in response.results) {
                    var dataList = response.results[i];
                    $('#sateliteId2').append($('<option>', {
                        value: dataList.location.trim(),
                        text: dataList.name.trim(),
                    }));
                }
                await sateliteChangeListener2();
            }
        });
        $("#sateliteSpinner").addClass('d-none');
    }

    async function sateliteChangeListener2() {
        $("#deviceSpinner").removeClass('d-none');
        $('#dataTable').DataTable({ "bDestroy": true }).clear();

        var sateliteValue = document.getElementById("sateliteId2").value;
        await getData(sateliteValue);
        $("#deviceSpinner").addClass('d-none');
    }
    //end of date location
</script>



