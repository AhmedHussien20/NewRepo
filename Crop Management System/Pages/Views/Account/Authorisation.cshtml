@page
@model Crop_Management_System.Pages.Views.Account.AuthorisationModel
@{
 Layout = null;
}

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    @*CSS*@
    <link rel="stylesheet" href="~/css/site.css" />

    @*dark theme*@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @*icofont*@
    <link rel="stylesheet" href="~/lib/icofont/icofont.min.css" />

    @*alertify*@
    <script src="~/lib/alertifyjs/alertify.min.js"></script>
    <link href="~/lib/alertifyjs/css/alertify.min.css" rel="stylesheet" />
    <link href="~/lib/alertifyjs/css/themes/default.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div id="layoutAuthentication">
        <div id="layoutAuthentication_content">
            <main>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-5">
                            <div class="card shadow-lg border-0 rounded-lg mt-5">
                                <div class="text-center card-header">
                                    <div>
                                        <img src="~/images/fra-logo.png" width="300" height="100" alt="No Image Found" />
                                    </div>
                                    <div>
                                        <h3 class=" font-weight-light my-4">FRA Management Console</h3>
                                    </div>
                                </div>
                                @if (Model.hasError)
                                {
                                    <div class="card-body">
                                        <div class="text-center">
                                            <label class="p-2 text-danger">@Model.message</label>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="card-body">
                                        <div class="text-center">
                                            <label class="p-2 font-weight-bold">Account Successfully Activated</label>
                                        </div>
                                        <div>
                                            <a asp-area="" asp-page="/Login"
                                               class="btn btn-primary w-100">Proceed to login</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    $(document).ready(async function () {
        await simulateAsycCall();
        displayMainBody();
    });
</script>