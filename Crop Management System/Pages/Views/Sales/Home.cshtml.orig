    function downloadPDF() {
        const iframe = document.getElementById('reportPageFrame');
        const iframeContent = iframe.contentWindow;
        const iframeDocument = iframeContent.document;
        const element = iframeDocument.getElementById('pdf-content');
        const doNumber = $('#reportDoNumber').val();
        const startDate = $('#reportStartDate').val();
        const endDate = $('#reportEndDate').val();
        const fileName = `${doNumber}_${startDate}_${endDate}.pdf`;
        html2pdf(element, {
            margin: 2,
            filename: fileName,
            jsPDF: { orientation: 'landscape' },
            scale: 1
        });
    }

