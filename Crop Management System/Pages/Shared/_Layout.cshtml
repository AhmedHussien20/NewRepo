                                </div>
                                PRCN
                            </a>
                            <a class="nav-link" asp-area="" asp-page="/Views/Transactions/BCLIndex">
                            <div class="sb-nav-link-icon">
                            <i class="icofont-money"></i>
                            </div>
                            BCL
                            </a>
                            <a class="nav-link" asp-area="" asp-page="/Views/Sales/Home">
                                <div class="sb-nav-link-icon">
                                    <i class="icofont-money"></i>
                                </div>
                                GIN
