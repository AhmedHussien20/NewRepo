            </div>
        </div>
    </div>-->
</div>

<script>
    $(document).ready(async function () {
        await generateCharts(provinceId = null, districtId = null, satelliteId = null,
            startDateFilter = new Date(2021, 0, 1).toISOString(), endDateFilter = new Date(9090, 0, 12).toISOString(), shouldFilter = false);
        //await getDevicesData();
        await getStats(provinceId = null, districtId = null, satelliteId = null,
            startDateFilter = new Date(2021, 0, 1).toISOString(), endDateFilter = new Date(9090, 0, 12).toISOString(), shouldFilter = false);
        displayMainBody();

    });

    async function getStats(provinceId, districtId, satelliteId, startDateFilter, endDateFilter, shouldFilter, cropId) {
        var formData = {
            "provinceId": provinceId,
            "districtId": districtId,
            "satelliteId": satelliteId,
            "endDateFilter": endDateFilter,
            "startDateFilter": startDateFilter,
            "shouldFilter": shouldFilter,
            "cropId": cropId
        }

        console.log(formData);
        await makePostRequest(formData, baseUrl + "getDashboardStats").then(response => {
            if (response != null) {
                var dataList = response.results;
                console.log(dataList);
                $('#transNum').html(dataList.transactionsCount);
                $('#farnNums').html(dataList.farmerCount);
                $('#deviceNum').html(dataList.totalBags + " | " + dataList.totalBags / 20 + "t");
                $('#revenuNum').html(converToMoneyFormat(dataList.revenue));
            }
        });
    }

    async function generateCharts(provinceId, districtId, satelliteId, startDateFilter, endDateFilter, shouldFilter, cropId) {
        var formData = {
            "provinceId": provinceId,
            "districtId": districtId,
            "satelliteId": satelliteId,
            "endDateFilter": endDateFilter,
            "startDateFilter": startDateFilter,
            "shouldFilter": shouldFilter,
            "cropId": cropId
        }

        await makePostRequest(formData, baseUrl + `getTransactionStatsByYear`).then(response => {
            if (response != null) {
                var data = [];
                var label = [];
                for (i in response.results) {
                    var colors = getRandomColor();
                    var dataList = response.results[i];

                    data.push(dataList.total);
                    label.push(getMonth(dataList.month));

                    var ctx = document.getElementById('monthRecords').getContext('2d');
                    var myChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: label,
                            datasets: [{
                                label: `${dataList.year} Transactions`,
                                data: data,
                                borderColor: colors,

                            }]
                        }
                    });
                }
            }
        });

        await makePostRequest(formData, baseUrl + `getTransactionStatsByWeek`).then(response => {
            if (response != null) {
                var data = [];
                var label = [];
                for (i in response.results) {
                    var colors = getRandomColor();
                    var dataList = response.results[i];

                    data.push(dataList.total);
                    label.push(getDay(dataList.week));

                    var ctx = document.getElementById('weekRecords').getContext('2d');
                    var myChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: label,
                            datasets: [{
                                label: `${getMonth(dataList.month)} Transactions`,
                                data: data,
                                borderColor: colors,
                            }]
                        }
                    });
                }
            }
        });

        await makePostRequest(formData, baseUrl + `getTransactionStatsBySatelietSales`).then(response => {
            if (response != null) {
                var data = [];
                var label = [];
                for (i in response.results) {
                    var colors = generateColor();
                    var dataList = response.results[i];
                     
                    data.push(dataList.total);
                    label.push(dataList.name.split(' - ')[0]);

                    var ctx = document.getElementById('stationRecords').getContext('2d');
                    var myChart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: label,
                            datasets: [{
                                label: `Satelite Transactions`,
                                data: data,
                                borderColor: colors,
                                backgroundColor: colors
                            }]
                        }
                    });
                }
            }
        });

        await makePostRequest(formData, baseUrl + `getTransactionStatsByCropsSold`).then(response => {
            if (response != null) {
                var data = [];
                var label = [];
                for (i in response.results) {
                    var colors = generateColor();
                    var dataList = response.results[i];

                    data.push(dataList.total);
                    label.push(dataList.title);

                    var ctx = document.getElementById('cropRecords').getContext('2d');
                    var myChart = new Chart(ctx, {
                        type: 'pie',
                        data: {
                            labels: label,
                            datasets: [{
                                label: `Satelite Transactions`,
                                data: data,
                                borderColor: colors,
                                backgroundColor: colors
                            }]
                        }
                    });
                }
            }
        });
    }

