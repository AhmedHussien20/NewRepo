@{
    ViewData["Title"] = "Transporter Form";
}

<div class="main-content flex-grow-1">
    <div class="my-2">
        <ol class="list-unstyled">
            <li class="active">
                <a href="@Url.Page("/Views/Transporter/Index")" class="ml-1 mr-1">Transporters</a> /
                <span class="">Create Transporter</span>
            </li>
        </ol>

    </div>
    <!-- Basic Layout -->
    <form id="formData" enctype="multipart/form-data">
        <input type="hidden" name="createdBy" value="" id="createdBy">
        <input type="hidden" name="modifyBy" value="" id="modifyBy">
        
        <div class="row g-2">
            <div class="col-sm-12 col-md-6">
                <div class="card mb-0">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Basic Information</h5>
                    </div>
                    <div class="card-body">
                        <div>
                            <div class="form-floating form-floating-outline mb-4">
                                <input type="text" class="form-control" name="Transporter" id="Transporter" placeholder="Transporter" required />
                                <label for="Transporter">Transporter</label>
                            </div>
                            <div class="form-floating form-floating-outline mb-4">
                                <input type="text" class="form-control" name="VehicleNumber" id="VehicleNumber" placeholder="Vehicle Number" required />
                                <label for="VehicleNumber">Vehicle Number</label>
                            </div>
                            <div class="form-floating form-floating-outline mb-4">
       q1                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       