            <div class="sb-nav-link-icon">
                <i class="icofont-satellite"></i>
            </div>
            Locations
        </a>*@
                            <a class="nav-link" asp-area="" asp-page="/Views/Transactions/Index">
                                <div class="sb-nav-link-icon">
