@page
@model Crop_Management_System.Pages.Staff.IndexModel
@{ }

<div>
    <h4 class="mt-4">Users Members</h4>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active"><a href='@Url.Action("Index","Home")' class="ml-1 mr-1">Dashboard</a> / Users</li>
    </ol>

    <div class="">
        <a href="@Url.Page("/Views/Staff/StaffCreation",new { status = 1 })"
           class="btn btn-primary w-100 font-weight-bold">Add User</a>
    </div>

    <div>
        <h5>Location Filter</h5>
        <div class="border border-info rounded p-3">
            <div class="row">
                <div class="col-md-4">
                    <label class="font-weight-bold">Province <i class="icofont-dotted-down"></i></label>
                    <select class="form-control " name="provinceId" id="provinceId" onchange="provinceChangeListener()" required>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="font-weight-bold">
                        <span id="districtSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                        District
                        <i class="icofont-dotted-down"></i>
                    </label>
                    <select class="form-control" name="districtId" id="districtId" onchange="districtChangeListener()" required>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="font-weight-bold">
                        <span id="sateliteSpinner" class="d-none spinner-border  spinner-grow-sm"></span>
                        Satellite
                        <i class="icofont-dotted-down"></i>
                    </label>
                    <select class="form-control" name="SateliteId" id="sateliteId" onchange="sateliteChangeListener()" required>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- database table -->
    <div class="mt-4 card mb-4">
        <div class="card-header">
            <i class="fas fa-table mr-1"></i>
            Current Users
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Names</th>
                            <th>Contact Information</th>
                            <th>Gender</th>
                            <th>Date Of Birth</th>
                            <th>Location</th>
                            <th>Role</th>
                            <th>Account Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableData" class=""></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="modal" class="modal fade ModelDialog" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <iframe name="dFrame" id="dummyframe" style="display: none;"></iframe>
            <form id="formData" target="dFrame" onsubmit="editForm()" enctype="multipart/form-data">
                <input type="hidden" name="id" />
                <input type="hidden" name="dbOperations" value="Create" />
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Device Modal</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Device ID</label>
                        <input type="text" class="form-control" name="deviceID" required autocomplete="off">
                        <label class="font-weight-bold">Device Bearer <i class="icofont-dotted-down"></i></label>
                        <select class="form-control" name="deviceBearer">
                            <option value="1">jane  Doe</option>
                            <option value="1">Michael Sama  Doe</option>
                            <option value="1">JAke Paul  Doe</option>
                        </select>
                        <label class="font-weight-bold">Device Status <i class="icofont-dotted-down"></i></label>
                        <select class="form-control" name="deviceStatus">
                            <option value="1">Active</option>
                            <option value="1">On Hold</option>
                            <option value="1">Deactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button id="btnEdit" type="submit" class="btn btn-primary">
                        <span id="btnSpinner" class="d-none spinner-border  spinner-grow-sm" role="status" aria-hidden="true"></span>
                        Save changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var url;

    //$(document).ready(async function () {
